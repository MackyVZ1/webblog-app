---
import { ArrowRight, BookOpen, Briefcase, Coffee, Cpu, Leaf, PenTool } from 'lucide-react';
import ArticleCard from '../components/ArticleCard.astro';
import { Newsletter } from '../components/Newsletter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiFetch, type ArticleList, type Category } from '../lib/api';

const [articles, categories] = await Promise.all([
  apiFetch<ArticleList>('/articles?limit=9'),
  apiFetch<Category[]>('/categories'),
]);
const featured = articles.items.find((article) => article.featured) || articles.items[0];
const latest = articles.items.filter((article) => article.id !== featured?.id).slice(0, 6);
const icons: Record<string, any> = { Cpu, PenTool, Briefcase, Coffee, Leaf, BookOpen };
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pulse & Pixel',
  url: Astro.site,
  potentialAction: { '@type': 'SearchAction', target: `${Astro.site}search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<BaseLayout categories={categories} jsonLd={websiteLd}>
  <section class="relative overflow-hidden border-b border-[var(--line)]">
    <div class="grid-noise absolute inset-0 opacity-40"></div>
    <div class="container-shell relative py-16 sm:py-20 lg:py-24">
      <div class="max-w-4xl">
        <p class="eyebrow">Independent ideas, thoughtfully told</p>
        <h1 class="font-display mt-6 text-balance text-[clamp(3.4rem,10vw,8.2rem)] font-semibold leading-[.86] tracking-[-.055em]">Stay curious.<br /><i class="font-normal text-[var(--brand)]">See differently.</i></h1>
        <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <p class="max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg">เรื่องเล่า ไอเดีย และมุมมองสำหรับคนที่อยากเข้าใจเทคโนโลยี งานสร้างสรรค์ ธุรกิจ และชีวิตให้ลึกกว่าเดิม</p>
          <a href="#latest" class="group flex shrink-0 items-center gap-3 text-sm font-bold">เริ่มสำรวจ <span class="grid h-10 w-10 place-items-center rounded-full border border-[var(--ink)] transition group-hover:bg-[var(--ink)] group-hover:text-white"><ArrowRight size={17} /></span></a>
        </div>
      </div>
    </div>
  </section>

  {featured && <section class="container-shell py-14 sm:py-18 lg:py-22">
    <div class="mb-7 flex items-center justify-between border-b border-[var(--line)] pb-4">
      <p class="text-xs font-bold uppercase tracking-[.15em]">Editor’s pick</p>
      <span class="text-xs text-[var(--muted)]">01 — Featured</span>
    </div>
    <ArticleCard article={featured} featured />
  </section>}

  <section class="border-y border-[var(--line)] bg-[var(--surface)] py-14 sm:py-18">
    <div class="container-shell">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="eyebrow">Explore topics</p><h2 class="font-display mt-3 text-4xl font-semibold sm:text-5xl">มีเรื่องให้ค้นพบเสมอ</h2></div>
        <a class="text-sm font-semibold text-[var(--brand)]" href="/search">ค้นหาทุกบทความ →</a>
      </div>
      <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((item) => {
          const Icon = icons[item.icon] || BookOpen;
          return <a href={`/categories/${item.slug}`} class="group flex items-center gap-4 rounded-2xl border border-[var(--line)] bg-[var(--paper)] p-5 transition hover:-translate-y-1 hover:bg-white hover:shadow-lg hover:shadow-black/5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl text-white" style={`background:${item.color}`}><Icon size={21} /></span>
            <span class="min-w-0 flex-1"><strong class="block">{item.name}</strong><span class="mt-1 block truncate text-xs text-[var(--muted)]">{item.description}</span></span>
            <ArrowRight className="text-[var(--muted)] transition group-hover:translate-x-1" size={17} />
          </a>;
        })}
      </div>
    </div>
  </section>

  <section id="latest" class="container-shell py-16 sm:py-20 lg:py-24">
    <div class="mb-10 flex items-end justify-between border-b border-[var(--line)] pb-5">
      <div><p class="eyebrow">Fresh perspectives</p><h2 class="font-display mt-3 text-4xl font-semibold sm:text-5xl">เรื่องล่าสุด</h2></div>
      <p class="hidden max-w-xs text-right text-sm leading-6 text-[var(--muted)] md:block">อ่านในจังหวะของคุณ และเก็บสิ่งที่มีความหมายไว้ได้นานขึ้น</p>
    </div>
    <div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <div class="container-shell"><Newsletter client:load /></div>
</BaseLayout>
