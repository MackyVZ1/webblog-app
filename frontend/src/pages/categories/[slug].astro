---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch, type ArticleList, type Category } from '../../lib/api';

const { slug } = Astro.params;
let category: Category;
try { category = await apiFetch<Category>(`/categories/${slug}`); }
catch { return Astro.redirect('/404'); }
const [categories, articles] = await Promise.all([
  apiFetch<Category[]>('/categories'),
  apiFetch<ArticleList>(`/articles?category=${slug}&limit=30`),
]);
---
<BaseLayout title={category.name} description={category.description} categories={categories}>
  <header class="relative overflow-hidden border-b border-[var(--line)] py-16 sm:py-20 lg:py-24">
    <div class="absolute inset-y-0 right-0 w-2/5 opacity-10" style={`background:${category.color}`}></div>
    <div class="grid-noise absolute inset-0 opacity-35"></div>
    <div class="container-shell relative">
      <p class="eyebrow">Topic</p>
      <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <h1 class="font-display text-[clamp(3.5rem,10vw,7rem)] font-semibold leading-none tracking-[-.045em]">{category.name}</h1>
        <div class="max-w-md"><p class="text-base leading-7 text-[var(--muted)] sm:text-lg">{category.description}</p><p class="mt-4 text-xs font-bold uppercase tracking-[.14em]">{articles.total} stories</p></div>
      </div>
    </div>
  </header>
  <section class="container-shell py-14 sm:py-18 lg:py-22">
    {articles.items.length > 0 ? <div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">{articles.items.map((article) => <ArticleCard article={article} />)}</div> : <div class="rounded-3xl border border-dashed border-[var(--line)] py-20 text-center"><h2 class="font-display text-3xl">กำลังเตรียมเรื่องใหม่</h2><p class="mt-3 text-[var(--muted)]">กลับมาอีกครั้งเร็ว ๆ นี้นะ</p></div>}
  </section>
</BaseLayout>

