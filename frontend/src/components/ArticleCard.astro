---
import type { Article } from '../lib/api';
import { formatThaiDate } from '../lib/utils';
interface Props { article: Article; featured?: boolean }
const { article, featured = false } = Astro.props;
---
<article class:list={['article-card group', featured && 'md:grid md:grid-cols-[1.2fr_.8fr] md:gap-8 md:items-center']}>
  <a href={`/articles/${article.slug}`} class:list={['block overflow-hidden rounded-[1.4rem] bg-[var(--surface-2)]', featured ? 'aspect-[16/11] md:aspect-[4/3]' : 'aspect-[16/10]']}>
    <img
      src={article.coverImage}
      alt={article.coverImageAlt || article.title}
      width="800"
      height="520"
      loading={featured ? 'eager' : 'lazy'}
      fetchpriority={featured ? 'high' : 'auto'}
      class="h-full w-full object-cover"
    />
  </a>
  <div class:list={[featured ? 'pt-6 md:pt-0' : 'pt-5']}>
    <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[.1em]">
      <a href={`/categories/${article.category.slug}`} style={`color:${article.category.color}`}>{article.category.name}</a>
      <span class="h-1 w-1 rounded-full bg-[var(--line)]"></span>
      <span class="text-[var(--muted)]">{article.readingTime} นาที</span>
    </div>
    <h2 class:list={['font-display mt-3 text-balance font-semibold leading-[1.15] transition group-hover:text-[var(--brand)]', featured ? 'text-3xl sm:text-4xl lg:text-5xl' : 'text-2xl']}>
      <a href={`/articles/${article.slug}`}>{article.title}</a>
    </h2>
    <p class:list={['mt-3 text-[var(--muted)]', featured ? 'text-base leading-7 lg:text-lg' : 'line-clamp-2 text-sm leading-6']}>{article.excerpt}</p>
    <div class="mt-5 flex items-center gap-3">
      {article.author.avatarUrl && <img class="h-8 w-8 rounded-full object-cover" src={article.author.avatarUrl} alt="" width="32" height="32" loading="lazy" />}
      <p class="text-xs text-[var(--muted)]"><span class="font-semibold text-[var(--ink)]">{article.author.name}</span><span class="mx-2">·</span>{formatThaiDate(article.publishedAt)}</p>
    </div>
  </div>
</article>

