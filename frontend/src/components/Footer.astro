---
import type { Category } from '../lib/api';
interface Props { categories?: Category[] }
const { categories = [] } = Astro.props;
---
<footer class="mt-24 border-t border-[var(--line)] bg-[var(--ink)] text-white">
  <div class="container-shell grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr] lg:py-18">
    <div>
      <a href="/" class="font-display text-3xl font-semibold">Pulse <i class="text-[var(--accent)]">&</i> Pixel</a>
      <p class="mt-4 max-w-sm text-sm leading-7 text-white/60">เรื่องเล่า ไอเดีย และมุมมองสำหรับคนที่อยากเข้าใจโลกที่เปลี่ยนเร็ว โดยไม่ต้องรีบตามทุกอย่าง</p>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[.15em] text-white/50">Explore</h2>
      <ul class="mt-4 grid gap-3 text-sm">
        {categories.slice(0, 4).map((item) => <li><a class="text-white/75 hover:text-white" href={`/categories/${item.slug}`}>{item.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[.15em] text-white/50">Connect</h2>
      <ul class="mt-4 grid gap-3 text-sm text-white/75">
        <li><a class="hover:text-white" href="/about">เกี่ยวกับเรา</a></li>
        <li><a class="hover:text-white" href="/rss.xml">RSS Feed</a></li>
        <li><a class="hover:text-white" href="/admin">สำหรับผู้เขียน</a></li>
      </ul>
    </div>
  </div>
  <div class="container-shell flex flex-col gap-3 border-t border-white/10 py-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} Pulse & Pixel. Crafted with curiosity.</p>
    <p>Astro × React × NestJS × PostgreSQL</p>
  </div>
</footer>

